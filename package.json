        "vue-loader": "^15.9.8",
        "vue-template-compiler": "^2.7.16",
        "webpack": "^5.88.2",
        "webpack-cli": "^4.10.0"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "leaflet": "^1.9.4",
        "vue": "^2.7.16",
        "vue-router": "^3.6.5",
        "vuetify": "^2.7.2",
        "vuex": "^3.6.2"
    }
